{
  "name": "hts-stage-planner",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "HOST=127.0.0.1 node --env-file=.env --import tsx scripts/dev.ts",
    "dev:api": "HOST=127.0.0.1 node --env-file=.env --import tsx --watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:local": "VITE_LOCAL_MODE=1 vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:local": "VITE_LOCAL_MODE=1 tsc --noEmit && VITE_LOCAL_MODE=1 vite build",
    "start": "HOST=127.0.0.1 node --env-file=.env dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "check:ci": "npm test && npm run test:integration && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/server/db/migrate.ts",
    "admin:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:smoke": "npm run build && playwright test tests/browser/workspace.spec.ts tests/browser/branding.spec.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.23",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-auth": "1.7.23",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "14.0.3"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
