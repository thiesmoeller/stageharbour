{
  "name": "hts-stage-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "HOST=127.0.0.1 node --env-file=.env --import tsx scripts/dev.ts",
    "dev:api": "HOST=127.0.0.1 node --env-file=.env --import tsx --watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "HOST=127.0.0.1 node --env-file=.env dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/server/db/migrate.ts",
    "admin:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "postinstall": "node scripts/patch-pascal-webgl.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:smoke": "npm run build && playwright test tests/browser/workspace.spec.ts tests/browser/branding.spec.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@pascal-app/core": "0.9.2",
    "@pascal-app/editor": "0.9.2",
    "@pascal-app/viewer": "0.9.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
