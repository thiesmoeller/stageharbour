DATABASE_URL=postgresql://stage_planner:local-development-only@127.0.0.1:55432/stage_planner
APP_ORIGIN=http://localhost:5173
# Optional: choose another browser port when 5173 is already in use.
# APP_ORIGIN=http://localhost:5174
WEB_PORT=5173
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
WORKSPACE_ID=2e9f08ac-373c-4aa9-8f5f-3cf994181ee8
WORKSPACE_NAME=Unsere Theatergruppe
PORT=3000
HOST=127.0.0.1
STORAGE_DIR=data/storage
# Optional container deployment: HTTPS reverse proxy origin and local upstream port.
# DEPLOY_APP_ORIGIN=https://planner.example.org
# BACKEND_PORT=3000
# CapRover: see docs/caprover.md. Production uses APP_ORIGIN=https://… and
# DATABASE_URL=…@srv-captain--stageplanner-db:5432/… ; STORAGE_DIR=/data/storage.
# Set only for the explicit admin:bootstrap command; remove afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional Pocket ID (generic OIDC). Leave unset to keep password-only sign-in.
# Redirect defaults to ${APP_ORIGIN}/api/auth/callback/pocket-id
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Optional until production email is configured. Required for invites, password
# reset, and magic-link sign-in. Tests never send real mail.
# Prefer Brevo SMTP (same credentials as WordPress / CapRover SMTP plugins):
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Optional alternative: Brevo HTTP API (not the SMTP key).
BREVO_API_KEY=
# Optional feedback recipient. Requires mail delivery above; server-only.
FEEDBACK_TO_EMAIL=
